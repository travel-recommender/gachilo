FROM node:24-bookworm-slim AS web
WORKDIR /app
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci
COPY web ./web
COPY config ./config
ARG NEXT_PUBLIC_GOOGLE_MAPS_API_KEY
ENV NEXT_PUBLIC_EXPERIMENT_MODE=1 NEXT_PUBLIC_API_BASE_URL=/backend NEXT_PUBLIC_BASE_PATH= NEXT_TELEMETRY_DISABLED=1
RUN test -n "$NEXT_PUBLIC_GOOGLE_MAPS_API_KEY" && cd web && npm run build

FROM node:24-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY scripts/requirements-experiment.txt /tmp/requirements-experiment.txt
RUN python3 -m venv /opt/venv && /opt/venv/bin/pip install --no-cache-dir -r /tmp/requirements-experiment.txt
COPY backend ./backend
COPY scripts ./scripts
COPY data ./data
COPY config ./config
COPY web/src ./web/src
COPY web/package.json ./web/package.json
COPY --from=web /app/web/out ./web/out
ENV PATH=/opt/venv/bin:$PATH PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
CMD ["python3", "scripts/experiment_cloud.py"]
