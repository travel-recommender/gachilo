# 로컬 서버 주소 (기본 http://127.0.0.1:8000)
NEXT_PUBLIC_API_BASE_URL=
# 구글 지도 JS API 키 (P5 숙소 검색, P8 지도). 실제 키는 .env.local에만 두고 커밋하지 않습니다.
# Google Cloud 콘솔에서 HTTP 리퍼러 제한과 API 제한(Maps JavaScript API, Places API (New))을 걸어 두세요.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# 새로 만드는 방의 장소 데이터 (기본 osaka_review_150 — 현재 최종 목록 205곳, 이름은 호환용). 데모 36곳으로 돌리려면 prototype_demo_36
NEXT_PUBLIC_DATASET=
